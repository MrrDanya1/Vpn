        "network": "tcp,udp",
        "balancerTag": "Super_Balancer"
      }
    ],
    "balancers": [
      {
        "tag": "Super_Balancer",
        "selector": ["proxy"],
        "strategy": {
          "type": "leastLoad",
          "settings": {
            "maxRTT": "2s",
            "expected": 2,
            "baselines": ["1s"],
            "tolerance": 0.01
          }
        },
        "fallbackTag": "proxy"
      }
    ],
    "domainMatcher": "hybrid",
    "domainStrategy": "AsIs"
  },
  "inbounds": [
